<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!--
      前台服务让连接活过界面。选它而不是 FCM 是有意的：FCM 需要 Google Play
      服务（国产 Android 大多不带）和 Firebase 凭据（自建用户拿不到）。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13 起是运行时权限；拒绝了也不影响同步，只是不主动提醒。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="ClawMe"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClawMe">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="ClawMe"
            android:theme="@style/Theme.ClawMe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ShadowSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
